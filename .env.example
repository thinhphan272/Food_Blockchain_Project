# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN SMARTCHAIN
# ==========================================

# 1. Cấu hình cổng dịch vụ
BACKEND_PORT=8080
FRONTEND_PORT=3000
MQTT_PORT=1883
MQTT_WS_PORT=9001

# 2. Cấu hình CSDL Quan hệ: MySQL 8.0
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=supermarket_db
MYSQL_USER=superuser
MYSQL_PASSWORD=superpassword
MYSQL_ROOT_PASSWORD=rootpassword

# 3. Cấu hình CSDL Document: MongoDB 6.0
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=supermarket_mongo
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongopassword

# 4. Cấu hình CSDL In-Memory: Redis 7.0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# 5. Cấu hình CSDL Time-Series: Apache Cassandra 4.1
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=supermarket_telemetry_ks

# 6. Cấu hình CSDL Đồ thị: Neo4j 5.x
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# 7. JWT Secret Key cho Spring Security
JWT_SECRET=SmartChainSecretKeyForSupermarketTraceability2026SuperSecureKey!
JWT_EXPIRATION_MS=86400000
