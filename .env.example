# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN SMARTCHAIN (BẢN MẪU VÍ DỤ)
# Hướng dẫn: Sao chép file này thành .env trên máy cá nhân để sử dụng: cp .env.example .env
# Tuyệt đối không lưu secret key hoặc mật khẩu thật vào file .env.example này.
# ==========================================

# 1. Cấu hình cổng dịch vụ
BACKEND_PORT=8080
FRONTEND_PORT=5173
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001

# 2. Cấu hình CSDL Quan hệ: MySQL 8.0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=supermarket_db
MYSQL_USER=your_mysql_username
MYSQL_PASSWORD=your_mysql_password_placeholder
MYSQL_ROOT_PASSWORD=your_root_password_placeholder

# 3. Cấu hình CSDL Document: MongoDB 6.0
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=supermarket_mongo
MONGO_USER=your_mongo_username
MONGO_PASSWORD=your_mongo_password_placeholder

# 4. Cấu hình CSDL In-Memory: Redis 7.0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_placeholder

# 5. Cấu hình CSDL Time-Series: Apache Cassandra 4.1
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=supermarket_telemetry_ks

# 6. Cấu hình CSDL Đồ thị: Neo4j 5.x
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password_placeholder

# 7. JWT Secret Key cho Spring Security (Tối thiểu 256 bits cho HS256)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here_example
JWT_EXPIRATION_MS=86400000

# 8. Google OAuth 2.0 Web Client ID (Google Identity Services GIS)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here.apps.googleusercontent.com
