# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN SMARTCHAIN
# (Mặc định dùng 'localhost' khi chạy Backend trên máy Host;
#  đổi thành 'mysql', 'mongodb', 'redis', 'cassandra', 'neo4j' khi chạy trong mạng nội bộ Docker Compose)
# ==========================================

# 1. Cấu hình cổng dịch vụ
BACKEND_PORT=8080
FRONTEND_PORT=3000
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_WS_PORT=9001

# 2. Cấu hình CSDL Quan hệ: MySQL 8.0
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=supermarket_db
MYSQL_USER=superuser
MYSQL_PASSWORD=superpassword
MYSQL_ROOT_PASSWORD=rootpassword

# 3. Cấu hình CSDL Document: MongoDB 6.0
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=supermarket_mongo
MONGO_USER=mongoadmin
MONGO_PASSWORD=mongopassword

# 4. Cấu hình CSDL In-Memory: Redis 7.0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# 5. Cấu hình CSDL Time-Series: Apache Cassandra 4.1
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=supermarket_telemetry_ks

# 6. Cấu hình CSDL Đồ thị: Neo4j 5.x
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword

# 7. JWT Secret Key cho Spring Security
JWT_SECRET=SmartChainSecretKeyForSupermarketTraceability2026SuperSecureKey!
JWT_EXPIRATION_MS=86400000

# 8. Google OAuth 2.0 Web Client ID (Google Identity Services GIS)
VITE_GOOGLE_CLIENT_ID=1071098222333-bhsipdrp2bv1421u51jk2tatt252221k.apps.googleusercontent.com
